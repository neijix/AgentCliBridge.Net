<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>D3sk.AgentCli</PackageId>
    <Description>Runs the AI coding CLIs (Claude Code, Cursor, Gemini, Copilot, Grok, OpenCode) and folds their output streams into typed events. .NET port of AgentCliBridge.</Description>
    <Authors>neijix</Authors>
    <Copyright>Copyright (c) 2026 neijix</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/neijix/AgentCliBridge.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/neijix/AgentCliBridge.Net</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
